<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules.
  User documents are excluded from cloud backup but included in device-to-device
  transfer, which is the private path the user controls.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="library/" />
        <exclude
            domain="file"
            path="captures/" />
        <exclude
            domain="file"
            path="exports/" />
        <exclude
            domain="file"
            path="manuals.json" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
