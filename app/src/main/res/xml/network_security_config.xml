<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is forbidden. The optional AI endpoint must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
