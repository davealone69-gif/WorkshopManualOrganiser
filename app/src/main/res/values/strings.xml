    <!-- About -->
    <string name="about_title">About / Credits</string>
    <string name="about_body">Workshop Manual Organiser\n\nScan, import and organise workshop manuals, decode VINs offline, browse wiring references and sort your library automatically.\n\nAll manuals and pages are stored privately on this device. No analytics, no advertising, no trackers.\n\nBuilt by REDRUM Studios.</string>
